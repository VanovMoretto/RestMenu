# Copie para .env.local e preencha (Supabase > Project Settings > API).
# A URL é só o domínio do projeto, sem /rest/v1.
# Use a chave "publishable" (pública). NUNCA coloque a secret/service_role aqui:
# tudo que começa com VITE_ vai parar no JavaScript do site.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Simulador de pagamento: coloque VITE_PAYMENT_SIMULATOR=true em .env.development.local
# (só vale no "npm run dev"; builds de produção ignoram).
